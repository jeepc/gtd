{
  "name": "loop-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:desktop": "pnpm --filter @loop/desktop dev",
    "dev:mobile": "pnpm --filter @loop/mobile start",
    "mcp": "cargo run --manifest-path apps/mcp-server/Cargo.toml"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.12.0"
  }
}
