{
  "name": "loop-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/mobile",
    "apps/desktop"
  ],
  "scripts": {
    "build": "bun run --filter='./packages/*' build",
    "test": "bun run --filter='*' test",
    "typecheck": "bun run --filter='*' typecheck",
    "dev:desktop": "bun run --filter @loop/desktop dev",
    "dev:mobile": "bun run --filter @loop/mobile start",
    "mcp": "cargo run --manifest-path apps/mcp-server/Cargo.toml"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.12.0"
  }
}
