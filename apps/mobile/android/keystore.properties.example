# Android 发布签名配置模板
#
# 用法：
#   1. 生成发布 keystore（详见 docs/RELEASING.md）：
#        keytool -genkeypair -v -keystore app/release.keystore \
#          -alias loop -keyalg RSA -keysize 2048 -validity 10000
#   2. 复制本文件为同目录下的 keystore.properties，填入下面的真实值。
#   3. release.keystore 与 keystore.properties 均已被 .gitignore 忽略，切勿提交。
#
# storeFile 相对 app/ 模块目录解析（即 apps/mobile/android/app/release.keystore）。
storeFile=release.keystore
storePassword=请填入-keystore-口令
keyAlias=loop
keyPassword=请填入-key-口令
